# ---------- Drex (the brain: classifies chat vs project, judges plans/proposals) ----------
# Get a key at https://console.nace.ai  (Drex System 1). Check the Nace docs for the exact
# base URL / model id and paste them here. Must be OpenAI-compatible (/chat/completions).
DREX_BASE_URL=
DREX_API_KEY=
DREX_MODEL=drex-max-v1.1
# If DREX_API_KEY is empty, Groq GPT-OSS-120B is used as a stand-in judge.

# ---------- Worker agents ----------
GROQ_API_KEY=    # https://console.groq.com (free tier)
GROQ_BIG=openai/gpt-oss-120b
GROQ_SMALL=openai/gpt-oss-20b
GROQ_BROWSER_SEARCH=true    # lets the 120B researcher browse the web

GEMINI_API_KEY=          # https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=gemini-3.8-flash

# Coder: local Ollama (no limits) ...
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-coder
# ... or OpenRouter (used only if USE_OLLAMA=false)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Set to 1 to run everything with fake agents (no keys needed) to test the UI/flow
MOCK=0
